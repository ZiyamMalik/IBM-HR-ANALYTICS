LastYear\", \"DistanceFromHome\", \"PercentSalaryHike\", \"CSI\"]\n","\n","for col in check_cols:\n","    q1 = df[col].quantile(0.25)\n","    q3 = df[col].quantile(0.75)\n","    iqr = q3 - q1\n","    outliers = ((df[col] < q1 - 1.5 * iqr) | (df[col] > q3 + 1.5 * iqr)).sum()\n","    print(f\"{col:22s} outliers: {outliers}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"zXLXzq5YRWg1","executionInfo":{"status":"ok","timestamp":1793052751665,"user_tz":-330,"elapsed":36,"user":{"displayName":"03_ziyam_2021_ECE","userId":"03350866408116492544"}},"outputId":"be9a9160-cf59-4179-cf1b-43fb8ec4b92d"},"execution_count":6,"outputs":[{"output_type":"stream","name":"stdout","text":["Age                    outliers: 0\n","MonthlyIncome          outliers: 114\n","TotalWorkingYears      outliers: 63\n","NumCompaniesWorked     outliers: 52\n","TrainingTimesLastYear  outliers: 238\n","DistanceFromHome       outliers: 0\n","PercentSalaryHike      outliers: 0\n","CSI                    outliers: 0\n"]}]},{"cell_type":"code","source":["# remove useless columns and 3 columns to prevent data leakage. Also separate Features and Target\n","\n","\n","\n","leak_cols = [\"YearsSinceLastPromotion\", \"YearsInCurrentRole\", \"YearsAtCompany\"]\n","useless_cols = [\"EmployeeCount\", \"Over18\", \"StandardHours\", \"EmployeeNumber\"]\n","y = df[\"CSI\"]\n","X = df.drop(columns=[\"CSI\", \"Attrition\"] + leak_cols + useless_cols)"],"metadata":{"id":"Cs_rgHONRbWM","executionInfo":{"status":"ok","timestamp":1793052793772,"user_tz":-330,"elapsed":5,"user":{"displayName":"03_ziyam_2021_ECE","userId":"03350866408116492544"}}},"execution_count":7,"outputs":[]},{"cell_type":"code","source":["# Feature creation\n","\n","\n","# Average years per employer: captures job-hopping behaviour\n","X[\"AvgYearsPerCompany\"] = X[\"TotalWorkingYears\"] / (X[\"NumCompaniesWorked\"] + 1)\n"],"metadata":{"id":"hRaN2EDaRlpT","executionInfo":{"status":"ok","timestamp":1793052821427,"user_tz":-330,"elapsed":76,"user":{"displayName":"03_ziyam_2021_ECE","userId":"03350866408116492544"}}},"execution_count":8,"outputs":[]},{"cell_type":"code","source":["# Train Test Split\n","\n","\n","\n","# Split first (80/20) so the test set stays unseen during preparation and tuning\n","from sklearn.model_selection import train_test_split\n","X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.20, random_state=42)\n"],"metadata":{"id":"tryl0oFJRsX3","executionInfo":{"status":"ok","timestamp":1793052840710,"user_tz":-330,"elapsed":1001,"user":{"displayName":"03_ziyam_2021_ECE","userId":"03350866408116492544"}}},"execution_count":9,"outputs":[]},{"cell_type":"code","source":["# Encoding and Scaling\n","\n","\n","\n","from sklearn.model_selection import train_test_split\n","from sklearn.compose import ColumnTransformer\n","from sklearn.preprocessing import StandardScaler\n","from sklearn.preprocessing import OneHotEncoder"],"metadata":{"id":"4jh-G-cIRww8","executionInfo":{"status":"ok","timestamp":1793052855115,"user_tz":-330,"elapsed":435,"user":{"displayName":"03_ziyam_2021_ECE","userId":"03350866408116492544"}}},"execution_count":10,"outputs":[]},{"cell_type":"code","source":["# separate numerical and categorical features\n","\n","\n","\n","num_features = X_train.select_dtypes(include=\"number\").columns.tolist()\n","cat_features = X_train.select_dtypes(exclude=\"number\").columns.tolist()"],"metadata":{"id":"7O_nRs5SR0gL","executionInfo":{"status":"ok","timestamp":1793052870836,"user_tz":-330,"elapsed":31,"user":{"displayName":"03_ziyam_2021_ECE","userId":"03350866408116492544"}}},"execution_count":11,"outputs":[]},{"cell_type":"code","source":["# StandardScaler: Linear/Ridge are sensitive to feature size\n","# OneHotEncoder: categories have no natural order, so each gets its own 0/1 column\n","def make_preprocessor():\n","    return ColumnTransformer([\n","        (\"num\", StandardScaler(), num_features),\n","        (\"cat\", OneHotEncoder(handle_unknown=\"ignore\"), cat_features)\n","    ])\n","\n","prep = make_preprocessor()\n","train_matrix = prep.fit_transform(X_train)\n","X_train_enc = pd.DataFrame(train_matrix, columns=prep.get_feature_names_out(), index=X_train.index)"],"metadata":{"id":"Wxg4W2H-R4aC","executionInfo":{"status":"ok","timestamp":1793052887278,"user_tz":-330,"elapsed":124,"user":{"displayName":"03_ziyam_2021_ECE","userId":"03350866408116492544"}}},"execution_count":12,"outputs":[]},{"cell_type":"code","source":["from scipy.stats import pearsonr\n","\n","# Pearson correlation and p-value of every encoded feature with CSI (training data only)\n","corr_rows = []\n","for col in X_train_enc.columns:\n","    r, p = pearsonr(X_train_enc[col], y_train)\n","    corr_rows.append([col, r, p])\n","\n","corr_table = pd.DataFrame(corr_rows, columns=[\"Feature\", \"Pearson_r\", \"p_value\"])\n","corr_table[\"Feature\"] = corr_table[\"Feature\"].str.split(\"__\").str[1]   # remove num__ / cat__ prefix\n","corr_table = corr_table.sort_values(\"Pearson_r\", key=abs, ascending=False).reset_index(drop=True)\n","\n","print(corr_table.head(10).to_string(float_format=lambda v: f\"{v:.4g}\"))\n","print(\"\\nStrongest absolute correlation:\", round(corr_table[\"Pearson_r\"].abs().max(), 3))\n","print(\"Possible leakage (any |r| > 0.8):\", (corr_table[\"Pearson_r\"].abs() > 0.8).any())\n","print(\"Features with p < 0.05:\", (corr_table[\"p_value\"] < 0.05).sum(), \"of\", len(corr_table))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"zYr8Lr98R8T4","executionInfo":{"status":"ok","timestamp":1793052908753,"user_tz":-330,"elapsed":57,"user":{"displayName":"03_ziyam_2021_ECE","userId":"03350866408116492544"}},"outputId":"2cb6ff55-467d-4d04-dc12-54805ebbd4e1"},"execution_count":13,"outputs":[{"output_type":"stream","name":"stdout","text":["                         Feature  Pearson_r   p_value\n","0           YearsWithCurrManager     0.3368 1.383e-32\n","1              TotalWorkingYears     0.1273 1.196e-05\n","2             AvgYearsPerCompany     0.1171 5.714e-05\n","3                  MonthlyIncome     0.1135 9.637e-05\n","4                       JobLevel      0.111 0.0001369\n","5  JobRole_Laboratory Technician    -0.1076 0.0002196\n","6        JobRole_Sales Executive    0.09104  0.001776\n","7                            Age     0.0791  0.006649\n","8          MaritalStatus_Married    0.07056   0.01551\n","9                     HourlyRate   -0.06005   0.03951\n","\n","Strongest absolute correlation: 0.337\n","Possible leakage (any |r| > 0.8): False\n","Features with p < 0.05: 10 of 49\n"]}]},{"cell_type":"code","source":["\n","# Model Phase\n","\n","\n","\n","from sklearn.pipeline import Pipeline\n","from sklearn.linear_model import LinearRegression, Ridge\n","from sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor\n","from sklearn.metrics import r2_score, mean_absolute_error, mean_squared_error\n","\n","\n","# Split the TRAINING data again (80% fit, 20% validation) so the test set is never used for tuning\n","X_tr, X_val, y_tr, y_val = train_test_split(X_train, y_train, test_size=0.20, random_state=42)\n","\n","\n","\n","\n","# Fits a pipeline on X_tr and returns the R2 on the validation part\n","def validation_r2(model):\n","    pipe = Pipeline([(\"prep\", make_preprocessor()), (\"model\", model)])\n","    pipe.fit(X_tr, y_tr)\n","    return r2_score(y_val, pipe.predict(X_val))"],"metadata":{"id":"wZ7tdPHXSBsf","executionInfo":{"status":"ok","timestamp":1793052939598,"user_tz":-330,"elapsed":696,"user":{"displayName":"03_ziyam_2021_ECE","userId":"03350866408116492544"}}},"execution_count":14,"outputs":[]},{"cell_type":"code","source":["# Ridge\n","\n","\n","\n","\n","\n","ridge_results = []\n","for alpha in [0.1, 1, 10, 50, 100, 300]:\n","    ridge_results.append([alpha, validation_r2(Ridge(alpha=alpha))])\n","\n","ridge_df = pd.DataFrame(ridge_results, columns=[\"alpha\", \"val_R2\"])\n","print(ridge_df.round(3))\n","\n","best_alpha = ridge_df.s